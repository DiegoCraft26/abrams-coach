# Datos generados o descargables: se regeneran con las herramientas del repo.
__pycache__/
*.pyc
*.pyo

# Capturas del escritorio: pesan y son de la máquina que corre la app.
salida/*.png
salida/calibracion/*
salida/diagnostico/

# Datos personales: la cuenta, el historial propio y las capturas de verdad terreno
# no pueden viajar en el repo. Cada quien genera los suyos (ver README).
.cuenta
data/mis_*.json
verdad/hud_*/
verdad/*_full.png

# Arte de Deadlock (© Valve): no se distribuye. `coach/iconos.py` lo baja en el
# primer arranque a data/iconos/.
data/iconos/

# Informes de sesión, experimentos y notas de traspaso: locales, no del repo público.
informes/
experimentos/
salida/archivo/
RELEVO.md
docs/SIGUIENTE-CHAT.md
docs/PROCESO-REVISION.md
docs/historia/

# Datos crudos grandes (se bajan con mineria.py / descargar_partidas.py).
data/ability-order.json
data/flujo.json
data/items.json
data/replay_cache.json
data/perm-2.json
data/perm-3.json

# Experimentos: scripts y resultados sí, imágenes pesadas no.
experimentos/**/*.png
experimentos/**/crops/

# Basura de editores / temporales.
*.log
.DS_Store
/tmp/

# Grabaciones del juego: 5 GB, se quedan fuera del repo (solo se indexan en la BD).
grabaciones/
datos/coach.db

# Registros de cada sesión: cambian en cada partida y su copia durable es la BD.
salida/*.jsonl
# Estado de la última lectura: es dato de la máquina, no del repo.
salida/estado_ultimo.json
salida/.estado-*.tmp
